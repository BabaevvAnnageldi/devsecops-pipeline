# Terraform: state files can contain secrets and resource IDs; never commit them
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*.tfplan
.terraformrc
terraform.rc

# Secrets / local env
.env
.env.*
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Scanner output
*.sarif
results/

# OS / editor
.DS_Store
.idea/
.vscode/
